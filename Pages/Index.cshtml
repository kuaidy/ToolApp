@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@model IndexModel

@inject IViewLocalizer ViewLocalizer;

@{
    ViewData["Title"] = ViewLocalizer["ToolOnline"].Value;
    if (string.IsNullOrWhiteSpace(ViewData["Title"] as string))
    {
        ViewData["Title"] = "在线工具箱";
    }
    ViewData["MetaDescription"] = ViewLocalizer["SeoHomeMetaDescription"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-page">
    <header class="home-hero">
        <h1 class="home-hero-main">@ViewLocalizer["HomeHeroHeadline"]</h1>
        <p class="home-hero-sub">@ViewLocalizer["HomeHeroLead"]</p>
    </header>

    <main class="home-main" id="tools">
    <section id="cat-image" class="home-cat-block">
