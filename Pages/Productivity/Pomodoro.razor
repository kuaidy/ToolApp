@page "/ProductiviryTools/Pomodoro"
@using System.Threading
@using System.Text.Json
@using ToolApp.Common
@using ToolApp.Models
@using ToolApp.Pages.Common
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="tool-page it-page pomodoro-page">
    <header class="it-hero">
        <h1>番茄钟</h1>
        <p>设定专注时长与备注，开始计时；完成后记录会保存在本机浏览器中，可在下方日历查看。</p>
    </header>

    <div class="it-studio">
        <div class="it-toolbar">
            <div class="it-toolbar-fields pomodoro-fields">
                <div class="it-field">
                    <span class="it-field-label">分钟（1–120）</span>
                    <input type="number"
                           class="form-control form-control-sm"
                           min="1"
                           max="120"
                           step="1"
                           @bind="MinuteCount"
                           @bind:event="onchange"
                           disabled="@IsSessionActive" />
                </div>
                <div class="it-field" style="flex:1 1 12rem;">
                    <span class="it-field-label">备注</span>
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="本次专注要做什么？"
                           @bind="Remark"
                           @bind:event="oninput" />
                </div>
            </div>
            <div class="it-toolbar-actions">
                @if (m_StartOrEndText == "开始")
                {
                    <button type="button" class="it-btn it-btn-primary" @onclick="StartOrEndAsync">开始</button>
                }
                else
                {
                    <button type="button" class="it-btn it-btn-outline" style="border-color:#dc3545;color:#dc3545;" @onclick="StartOrEndAsync">结束</button>
                    <button type="button" class="it-btn it-btn-outline" @onclick="PauseOrResume">@m_PauseOrResumeText</button>
                }
            </div>
        </div>

        <div class="pomodoro-timer-wrap">
            <div class="pomodoro-timer" aria-live="polite">@TimeLeft</div>
            @if (AllCount > 0)
            {
                <div class="progress pomodoro-progress" role="progressbar"
                     aria-valuenow="@CurrenCount" aria-valuemin="0" aria-valuemax="@AllCount">
                    <div class="progress-bar" style="width:@ProgressPercent%"></div>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <div class="it-message @(StatusMessageClass == "tool-message--success" ? "it-message--busy" : StatusMessageClass == "tool-message--error" ? "it-message--error" : "it-message--busy") mt-2" role="status">@StatusMessage</div>
        }
    </div>

    <div class="it-studio">
        <p class="it-studio-title" style="font-size:0.9375rem;font-weight:600;margin:0 0 0.85rem;padding-bottom:0.5rem;border-bottom:1px solid #eee;">专注记录</p>
        <div class="pomodoro-heatmap-wrap">
            <table class="pomodoro-heatmap-labels" aria-hidden="true">
                <tr><td></td></tr>
                <tr><td>一</td></tr>
                <tr><td></td></tr>
                <tr><td>三</td></tr>
                <tr><td></td></tr>
                <tr><td>五</td></tr>
                <tr><td></td></tr>
            </table>
            <table class="pomodoro-heatmap">
                @for (var i = 0; i < 7; i++)
                {
                    <tr>
                        @for (var j = 1; j <= weeks; j++)
                        {
                            var dateInfo = DateInfos.Find(x => x.X == j && x.Y == i);
                            if (dateInfo != null)
                            {
                                <td class="pomodoro-heatmap-cell"
                                    style="background-color:@dateInfo.Color"
                                    title="@($"{dateInfo.Day}：{dateInfo.Count} 个番茄")"
                                    @onclick="() => SelectedDay(dateInfo)"></td>
                            }
                            else
                            {
                                <td class="pomodoro-heatmap-cell pomodoro-heatmap-cell--empty"></td>
                            }
                        }
                    </tr>
                }
            </table>
        </div>
        <p class="it-note mt-2 mb-0">点击色块查看当天记录；颜色越深表示当天完成的番茄越多。</p>

        @if (m_toDayPomodoreRecords is { Count: > 0 })
        {
            <ul class="list-group mt-3">
                @foreach (var record in m_toDayPomodoreRecords.OrderByDescending(r => r.StartTime))
                {
                    <li class="list-group-item">
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(record.Remark) ? "未填写备注" : record.Remark)</div>
                        <div class="text-muted small">@FormatRecordSummary(record)</div>
                    </li>
                }
            </ul>
        }
        else if (!string.IsNullOrEmpty(SelectedDayLabel))
        {
            <p class="text-muted small mt-3 mb-0">@SelectedDayLabel 暂无记录。</p>
        }
    </div>

    <section class="it-features">
        <Description DescFileName="Productivity/Pomodoro.md" EmbedOnly="true" />
    </section>
</div>

@code {
    private const string DbName = "ToolAppDb";
    private const string DbVersion = "1";
    private const string ObjectStoreName = "PomodoroRecord";

    private int MinuteCount { get; set; } = 25;
    private string Remark { get; set; } = "";
    private string TimeLeft { get; set; } = "25:00";
    private int CurrenCount { get; set; }
    private int AllCount { get; set; }
    private string StatusMessage { get; set; } = "";
    private string StatusMessageClass { get; set; } = "tool-message--busy";
    private string SelectedDayLabel { get; set; } = "";

    private DateTime m_StartTime;
    private DateTime m_EndTime;
    private int weeks;
    private readonly List<DateInfo> DateInfos = new();
    private List<PomodoreRecord> m_PomodoreRecords = new();
    private List<PomodoreRecord> m_toDayPomodoreRecords = new();

    private Timer? timer;
    private bool isRunning;

    private string m_StartOrEndText = "开始";
    private string m_PauseOrResumeText = "暂停";

    private bool IsSessionActive => timer != null;

    private int ProgressPercent =>
        AllCount > 0 ? (int)Math.Round(CurrenCount * 100.0 / AllCount) : 0;

    protected override void OnInitialized()
    {
        ResetCountdownFromMinutes();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("MyIndexedDB.Create", DbName, DbVersion, ObjectStoreName);
            await StatisticAsync(DateTime.Now.Year);
        }
    }

    private void ResetCountdownFromMinutes()
    {
        MinuteCount = Math.Clamp(MinuteCount, 1, 120);
        AllCount = MinuteCount * 60;
        CurrenCount = AllCount;
        UpdateTimeDisplay();
    }

    private void UpdateTimeDisplay()
    {
        var m = Math.Max(0, CurrenCount) / 60;
        var s = Math.Max(0, CurrenCount) % 60;
        TimeLeft = $"{m:D2}:{s:D2}";
    }

    private void StartTimer()
    {
        if (timer != null)
        {
            return;
        }

        timer = new Timer(TimerCallback, null, 0, 1000);
        isRunning = true;
        m_StartTime = DateTime.Now;
    }

    private void PauseTimer()
    {
        if (timer == null || !isRunning)
        {
            return;
        }

        timer.Change(Timeout.Infinite, Timeout.Infinite);
        isRunning = false;
    }

    private void ResumeTimer()
    {
        if (timer == null || isRunning)
        {
            return;
        }

        timer.Change(0, 1000);
        isRunning = true;
    }

    private async Task StopTimerAsync()
    {
        if (timer == null)
        {
            return;
        }

        await timer.DisposeAsync();
        timer = null;
        isRunning = false;
        m_EndTime = DateTime.Now;
        ShowCompletionMessage();
        await AddPomodoroRecordAsync();
        await StatisticAsync(DateTime.Now.Year);
        ResetCountdownFromMinutes();
    }

    private void TimerCallback(object? state)
    {
        if (CurrenCount <= 0)
        {
            return;
        }

        CurrenCount--;
        UpdateTimeDisplay();

        if (CurrenCount <= 0)
        {
            _ = InvokeAsync(async () =>
            {
                await StopTimerAsync();
                m_StartOrEndText = "开始";
                m_PauseOrResumeText = "暂停";
            });
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task StartOrEndAsync()
    {
        StatusMessage = "";
        if (m_StartOrEndText == "开始")
        {
            ResetCountdownFromMinutes();
            StartTimer();
            m_StartOrEndText = "结束";
            m_PauseOrResumeText = "暂停";
        }
        else
        {
            await StopTimerAsync();
            m_StartOrEndText = "开始";
            m_PauseOrResumeText = "暂停";
        }
    }

    private void PauseOrResume()
    {
        if (m_PauseOrResumeText == "暂停")
        {
            PauseTimer();
            m_PauseOrResumeText = "继续";
        }
        else
        {
            ResumeTimer();
            m_PauseOrResumeText = "暂停";
        }
    }

    private void ShowCompletionMessage()
    {
        var minutes = Math.Max(1, (int)Math.Round((m_EndTime - m_StartTime).TotalMinutes));
        var title = string.IsNullOrWhiteSpace(Remark) ? "本次专注已完成" : Remark.Trim();
        StatusMessageClass = "tool-message--success";
        StatusMessage = $"{title}：{m_StartTime:HH:mm}–{m_EndTime:HH:mm}，共专注 {minutes} 分钟。";
    }

    private async Task AddPomodoroRecordAsync()
    {
        try
        {
            var record = new PomodoreRecord
            {
                Guid = Guid.NewGuid().ToString(),
                StartTime = m_StartTime,
                EndTime = m_EndTime,
                Remark = Remark?.Trim() ?? ""
            };
            m_PomodoreRecords.Add(record);
            await JS.InvokeVoidAsync("MyIndexedDB.Add", DbName, DbVersion, ObjectStoreName, record);
        }
        catch
        {
            StatusMessageClass = "tool-message--error";
            StatusMessage = "记录保存失败，请检查浏览器是否允许本地存储。";
        }
    }

    private async Task StatisticAsync(int year)
    {
        var data = await JS.InvokeAsync<string>("MyIndexedDB.GetAll", DbName, DbVersion, ObjectStoreName);
        if (!string.IsNullOrEmpty(data))
        {
            var options = new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                Converters = { new JsonDateTimeConverter() }
            };
            m_PomodoreRecords = JsonSerializer.Deserialize<List<PomodoreRecord>>(data, options) ?? new List<PomodoreRecord>();
        }
        else
        {
            m_PomodoreRecords = new List<PomodoreRecord>();
        }

        var dayCount = DateTime.IsLeapYear(year) ? 366 : 365;
        var firstDay = new DateTime(year, 1, 1);
        DateInfos.Clear();
        weeks = 0;

        for (var i = 0; i < dayCount; i++)
        {
            var tempDay = firstDay.AddDays(i);
            var dateInfo = new DateInfo
            {
                Day = tempDay.ToString("yyyy-MM-dd"),
                Y = (int)tempDay.DayOfWeek,
                X = (int)Math.Ceiling((i + (int)firstDay.DayOfWeek + 1) / 7.0),
                Count = m_PomodoreRecords.Count(x => x.StartTime.ToString("yyyy-MM-dd") == tempDay.ToString("yyyy-MM-dd"))
            };

            dateInfo.Color = dateInfo.Count switch
            {
                > 0 and <= 5 => "#0e4429",
                > 5 and <= 10 => "#006d32",
                > 10 and <= 15 => "#26a641",
                > 15 => "#39d353",
                _ => "#ebedf0"
            };

            weeks = Math.Max(weeks, dateInfo.X);
            DateInfos.Add(dateInfo);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void SelectedDay(DateInfo dateInfo)
    {
        SelectedDayLabel = dateInfo.Day;
        m_toDayPomodoreRecords = m_PomodoreRecords
            .Where(x => x.StartTime.ToString("yyyy-MM-dd") == dateInfo.Day)
            .ToList();
    }

    private static string FormatRecordSummary(PomodoreRecord record)
    {
        var minutes = Math.Max(1, (int)Math.Round((record.EndTime - record.StartTime).TotalMinutes));
        return $"{record.StartTime:HH:mm}–{record.EndTime:HH:mm}，专注 {minutes} 分钟";
    }

    public async ValueTask DisposeAsync()
    {
        if (timer != null)
        {
            await timer.DisposeAsync();
        }
    }
}
