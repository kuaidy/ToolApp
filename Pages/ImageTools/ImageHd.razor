@page "/imagetools/imagehd"
@using System.IO
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using SixLabors.ImageSharp
@using ToolApp.Common
@using ToolApp.Services
@inject IJSRuntime JS
@inject IStringLocalizer<ImageHd> L

<div class="tool-page it-page">
    <header class="it-hero">
        <h1>@L["PageTitle"]</h1>
        <p>@L["LeadShort"]</p>
    </header>

    <div class="it-studio">
        @if (!HasImage)
        {
            <label class="it-dropzone it-dropzone--in-studio @(Busy ? "it-dropzone--disabled" : "")">
                <span class="it-dropzone-icon" aria-hidden="true">+</span>
                <span class="it-dropzone-title">@L["PageTitle"]</span>
                <span class="it-dropzone-hint">@L["DropzoneHint"]</span>
                <InputFile OnChange="OnFileSelectedAsync" accept="image/*" class="it-dropzone-input" disabled="@Busy" />
            </label>
        }
        else
        {
            <div class="it-toolbar">
                <div class="it-toolbar-fields">
                    <div class="it-field">
                        <span class="it-field-label">@L["LabelScale"]</span>
                        <select class="form-select form-select-sm" @bind="Scale" disabled="@Busy">
                            <option value="2">2×</option>
                            <option value="3">3×</option>
                            <option value="4">4×</option>
                        </select>
                    </div>
                    <div class="it-field it-field--gap">
                        <span class="it-field-label">@L["LabelSharpen", Sharpen]</span>
                        <input type="range" class="form-range" min="0" max="100" step="10"
                               @bind="Sharpen" @bind:event="oninput" disabled="@Busy" />
                    </div>
                    <div class="it-field">
                        <span class="it-field-label">@L["LabelOutputFormat"]</span>
                        <select class="form-select form-select-sm" value="@OutputMime" @onchange="OnOutputMimeChange" disabled="@Busy">
                            <option value="image/png">PNG</option>
                            <option value="image/jpeg">JPEG</option>
                        </select>
                    </div>
                    @if (IsJpegOutput)
                    {
                        <div class="it-field">
                            <span class="it-field-label">@L["LabelJpegQuality"]</span>
                            <select class="form-select form-select-sm" @bind="JpegQuality" disabled="@Busy">
                                <option value="85">85</option>
                                <option value="90">90</option>
                                <option value="95">95</option>
                            </select>
                        </div>
                    }
                </div>
                <div class="it-toolbar-actions">
                    <button type="button" class="it-btn it-btn-primary" @onclick="ProcessAsync" disabled="@Busy">@L["BtnProcess"]</button>
                    <button type="button" class="it-btn it-btn-outline" @onclick="RestorePreviewAsync" disabled="@Busy">@L["BtnRestorePreview"]</button>
                    <button type="button" class="it-btn it-btn-outline" @onclick="DownloadAsync" disabled="@(Busy || !HasResult)">@L["BtnDownload"]</button>
                    <button type="button" class="it-btn it-btn-outline" @onclick="ClearAllAsync">@L["BtnClear"]</button>
                </div>
            </div>

            @if (OrigW > 0)
            {
                <p class="it-meta">@L["OriginalInfo", OrigW, OrigH, FormatSize(OriginalBytes)]</p>
            }
            @if (HasResult && OutW > 0)
            {
                <p class="it-meta">@L["ResultInfo", OutW, OutH, FormatSize(ResultBytes)]</p>
            }
            @if (Busy)
            {
                <div class="it-message it-message--busy" role="status">@L["Busy"]</div>
            }
            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <div class="it-message it-message--error" role="alert">@StatusMessage</div>
            }
        }

        <div class="it-viewport it-viewport--checker @(HasImage ? "" : "it-viewport--hidden")">
            <div class="it-viewport-canvas">
                <canvas id="@CanvasId"></canvas>
            </div>
            @if (Busy && HasImage)
            {
                <div class="it-viewport-overlay it-viewport-overlay--light">@L["Busy"]</div>
            }
        </div>
    </div>

</div>

@code {
    private const string CanvasId = "image-hd-canvas";
    private const long MaxFileSize = 20 * 1024 * 1024;

    private bool Busy { get; set; }
    private bool HasImage { get; set; }
    private bool HasResult { get; set; }
    private string StatusMessage { get; set; } = "";
    private byte[] LastFileBytes { get; set; } = Array.Empty<byte>();
    private string LastContentType { get; set; } = "image/png";
    private int OrigW { get; set; }
    private int OrigH { get; set; }
    private int OriginalBytes { get; set; }
    private int Scale { get; set; } = 2;
    private int Sharpen { get; set; } = 40;
    private string OutputMime { get; set; } = "image/png";
    private int JpegQuality { get; set; } = 90;
    private string ResultBase64 { get; set; } = "";
    private string ResultMime { get; set; } = "";
    private int OutW { get; set; }
    private int OutH { get; set; }
    private long ResultBytes { get; set; }

    private bool IsJpegOutput => string.Equals(OutputMime, "image/jpeg", StringComparison.OrdinalIgnoreCase);

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:0.##} KB";
        }

        return $"{bytes / (1024.0 * 1024):0.##} MB";
    }

    private void OnOutputMimeChange(ChangeEventArgs e)
    {
        OutputMime = e.Value?.ToString() ?? "image/png";
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        StatusMessage = "";
        HasResult = false;
        ResultBase64 = "";
        OutW = OutH = 0;
        ResultBytes = 0;
        var file = e.File;
        if (file == null)
        {
            return;
        }

        Busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            LastFileBytes = ms.ToArray();
            OriginalBytes = LastFileBytes.Length;
            LastContentType = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;

            if (ImagePreviewDataUrl.TryGetDimensions(LastFileBytes, out var ow, out var oh))
            {
                OrigW = ow;
                OrigH = oh;
                var previewUrl = await Task.Run(() => ImagePreviewDataUrl.Create(LastFileBytes, LastContentType));
                var dim = await JS.InvokeAsync<DimResult>("imageHd.loadDataUrl", CanvasId, previewUrl, OrigW, OrigH);
                if (dim == null || dim.width < 1 || dim.height < 1)
                {
                    StatusMessage = L["ErrLoad"];
                    HasImage = false;
                    OrigW = OrigH = 0;
                    OriginalBytes = 0;
                    return;
                }

                await JS.InvokeAsync<DimResult>(
                    "imageHd.upgradeToFullUpload",
                    CanvasId,
                    $"data:{LastContentType};base64,{Convert.ToBase64String(LastFileBytes)}");
                HasImage = true;
            }
            else
            {
                var dataUrl = $"data:{LastContentType};base64,{Convert.ToBase64String(LastFileBytes)}";
                var dim = await JS.InvokeAsync<DimResult>("imageHd.loadDataUrl", CanvasId, dataUrl);
                if (dim == null || dim.width < 1 || dim.height < 1)
                {
                    StatusMessage = L["ErrLoad"];
                    HasImage = false;
                    OrigW = OrigH = 0;
                    OriginalBytes = 0;
                    return;
                }

                OrigW = dim.width;
                OrigH = dim.height;
                HasImage = true;
            }
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrReadImage", ex.Message];
            HasImage = false;
            LastFileBytes = Array.Empty<byte>();
            OrigW = OrigH = 0;
            OriginalBytes = 0;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ProcessAsync()
    {
        if (!HasImage || LastFileBytes.Length == 0)
        {
            return;
        }

        StatusMessage = "";
        Busy = true;
        try
        {
            var outputMime = string.IsNullOrWhiteSpace(OutputMime) ? "image/png" : OutputMime.Trim();
            if (!IsAllowedOutputMime(outputMime))
            {
                StatusMessage = L["ErrProcess"];
                HasResult = false;
                return;
            }

            await using var input = new MemoryStream(LastFileBytes, writable: false);
            var (bytes, outW, outH) = await ImageHdUpscaleService.UpscaleAsync(
                input,
                Scale,
                Sharpen,
                outputMime,
                JpegQuality);

            ResultBase64 = Convert.ToBase64String(bytes);
            ResultMime = outputMime.Equals("image/jpeg", StringComparison.OrdinalIgnoreCase) ? "image/jpeg" : "image/png";
            OutW = outW;
            OutH = outH;
            ResultBytes = bytes.LongLength;
            HasResult = true;

            if (ImagePreviewDataUrl.TryGetDimensions(bytes, out _, out _))
            {
                var previewUrl = await Task.Run(() => ImagePreviewDataUrl.Create(bytes, ResultMime));
                await JS.InvokeAsync<DimResult>("imageHd.loadDataUrl", CanvasId, previewUrl, OutW, OutH);
                await JS.InvokeAsync<DimResult>(
                    "imageHd.upgradeCanvasPreview",
                    CanvasId,
                    $"data:{ResultMime};base64,{ResultBase64}");
            }
            else
            {
                var previewUrl = $"data:{ResultMime};base64,{ResultBase64}";
                await JS.InvokeAsync<DimResult>("imageHd.loadDataUrl", CanvasId, previewUrl);
            }
        }
        catch (UnknownImageFormatException)
        {
            StatusMessage = L["ErrLoad"];
            HasResult = false;
            ResultBase64 = "";
        }
        catch (InvalidOperationException ex)
        {
            StatusMessage = string.IsNullOrWhiteSpace(ex.Message) ? L["ErrProcess"] : ex.Message;
            HasResult = false;
            ResultBase64 = "";
        }
        catch (ArgumentException ex)
        {
            StatusMessage = string.IsNullOrWhiteSpace(ex.Message) ? L["ErrProcess"] : ex.Message;
            HasResult = false;
            ResultBase64 = "";
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrProcessDetail", ex.Message];
            HasResult = false;
            ResultBase64 = "";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task RestorePreviewAsync()
    {
        StatusMessage = "";
        Busy = true;
        try
        {
            var res = await JS.InvokeAsync<OkResult>("imageHd.restoreOriginal", CanvasId);
            if (res == null || !res.ok)
            {
                StatusMessage = L["ErrRestore"];
                return;
            }

            HasResult = false;
            ResultBase64 = "";
            OutW = OutH = 0;
            ResultBytes = 0;
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrProcessDetail", ex.Message];
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task DownloadAsync()
    {
        StatusMessage = "";
        try
        {
            if (string.IsNullOrEmpty(ResultBase64))
            {
                return;
            }

            var ext = ResultMime.Contains("jpeg", StringComparison.OrdinalIgnoreCase) ? ".jpg" : ".png";
            var name = $"hd-{DateTime.Now:yyyyMMdd-HHmmss}{ext}";
            await JS.InvokeVoidAsync("imageHd.downloadBase64", ResultBase64, ResultMime, name);
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrDownload", ex.Message];
        }
    }

    private async Task ClearAllAsync()
    {
        StatusMessage = "";
        HasImage = false;
        HasResult = false;
        LastFileBytes = Array.Empty<byte>();
        OrigW = OrigH = 0;
        OriginalBytes = 0;
        ResultBase64 = "";
        OutW = OutH = 0;
        ResultBytes = 0;
        await JS.InvokeVoidAsync("imageHd.reset", CanvasId);
    }

    private static bool IsAllowedOutputMime(string m) =>
        m.Equals("image/png", StringComparison.OrdinalIgnoreCase)
        || m.Equals("image/jpeg", StringComparison.OrdinalIgnoreCase);

    private sealed class DimResult
    {
        public int width { get; set; }
        public int height { get; set; }
    }

    private sealed class OkResult
    {
        public bool ok { get; set; }
    }
}
