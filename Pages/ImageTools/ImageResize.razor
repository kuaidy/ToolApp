@page "/imagetools/imageresize"
@using System.IO
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Forms
@using ToolApp.Common
@inject IJSRuntime JS
@inject IStringLocalizer<ImageResize> L

<div class="tool-page it-page">
    <header class="it-hero">
        <h1>@L["PageTitle"]</h1>
        <p>@L["LeadShort"]</p>
    </header>

    <div class="it-studio">
        @if (!HasImage)
        {
            <label class="it-dropzone it-dropzone--in-studio @(Busy ? "it-dropzone--disabled" : "")">
                <span class="it-dropzone-icon" aria-hidden="true">+</span>
                <span class="it-dropzone-title">@L["PageTitle"]</span>
                <span class="it-dropzone-hint">@L["DropzoneHint"]</span>
                <InputFile OnChange="OnFileSelectedAsync" accept="image/*" class="it-dropzone-input" disabled="@Busy" />
            </label>
        }
        else
        {
            <div class="it-toolbar">
                <div class="it-toolbar-fields">
                    <div class="it-field it-field--narrow">
                        <span class="it-field-label">@L["LabelWidth"]</span>
                        <input type="number" class="form-control form-control-sm" min="1" max="16384" step="1"
                               value="@TargetW" @oninput="OnWidthInput" disabled="@Busy" />
                    </div>
                    <div class="it-field it-field--narrow">
                        <span class="it-field-label">@L["LabelHeight"]</span>
                        <input type="number" class="form-control form-control-sm" min="1" max="16384" step="1"
                               value="@TargetH" @oninput="OnHeightInput" disabled="@Busy" />
                    </div>
                    <label class="form-check">
                        <InputCheckbox @bind-Value="MaintainAspect" @bind-Value:after="OnMaintainAspectAfterAsync"
                                       class="form-check-input" disabled="@Busy" />
                        <span class="form-check-label">@L["LabelMaintainAspect"]</span>
                    </label>
                    <div class="it-field">
                        <span class="it-field-label">@L["LabelOutputFormat"]</span>
                        <select class="form-select form-select-sm" @bind="OutputMime" disabled="@Busy">
                            <option value="image/png">PNG</option>
                            <option value="image/jpeg">JPEG</option>
                            <option value="image/webp">WebP</option>
                        </select>
                    </div>
                </div>
                <div class="it-toolbar-actions">
                    <button type="button" class="it-btn it-btn-primary"
                            @onclick="ApplyResizeAsync"
                            disabled="@(Busy || TargetW < 1 || TargetH < 1)">@L["BtnApply"]</button>
                    <button type="button" class="it-btn it-btn-outline"
                            @onclick="RestoreOriginalAsync"
                            disabled="@Busy">@L["BtnRestoreOriginal"]</button>
                    <button type="button" class="it-btn it-btn-outline"
                            @onclick="DownloadAsync"
                            disabled="@Busy">@L["BtnDownload"]</button>
                    <button type="button" class="it-btn it-btn-outline"
                            @onclick="ClearAllAsync">@L["BtnClear"]</button>
                </div>
            </div>

            <p class="it-meta">@L["SectionQuickScale"]</p>
            <div class="it-scale-presets">
                @foreach (var pct in ScalePresets)
                {
                    var p = pct;
                    <button type="button" class="it-btn it-btn-outline it-btn-sm"
                            @onclick="@(() => ApplyPercentAsync(p))"
                            disabled="@(Busy || OrigW <= 0)">
                        @p%
                    </button>
                }
            </div>
            @if (OrigW > 0)
            {
                <p class="it-meta">@L["OriginalSize", OrigW, OrigH]</p>
            }
            @if (Busy)
            {
                <div class="it-message it-message--busy" role="status">@L["Busy"]</div>
            }
            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <div class="it-message it-message--error" role="alert">@StatusMessage</div>
            }
            @if (OutputMime != "image/png")
            {
                <p class="it-note mb-2">@L["NoteNonPngAlpha"]</p>
            }
        }

        <div class="it-viewport it-viewport--checker @(HasImage ? "" : "it-viewport--hidden")">
            <div class="it-viewport-canvas">
                <canvas id="@CanvasId"></canvas>
            </div>
            @if (Busy && HasImage)
            {
                <div class="it-viewport-overlay it-viewport-overlay--light">@L["Busy"]</div>
            }
        </div>
    </div>

    <section class="it-features">
        <p class="it-features-desc">@L["Lead"]</p>
    </section>
</div>

@code {
    private const string CanvasId = "image-resize-canvas";
    private const long MaxFileSize = 12 * 1024 * 1024;

    private static readonly int[] ScalePresets = [25, 50, 75, 100, 150, 200];

    private bool Busy { get; set; }
    private bool HasImage { get; set; }
    private string StatusMessage { get; set; } = "";
    private byte[] LastFileBytes { get; set; } = Array.Empty<byte>();
    private string LastContentType { get; set; } = "image/png";
    private int OrigW { get; set; }
    private int OrigH { get; set; }
    private int TargetW { get; set; } = 1;
    private int TargetH { get; set; } = 1;
    private bool MaintainAspect { get; set; } = true;
    private string OutputMime { get; set; } = "image/png";

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        StatusMessage = "";
        var file = e.File;
        if (file == null)
        {
            return;
        }

        Busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            LastFileBytes = ms.ToArray();
            LastContentType = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;

            if (ImagePreviewDataUrl.TryGetDimensions(LastFileBytes, out var ow, out var oh))
            {
                OrigW = ow;
                OrigH = oh;
                var previewUrl = await Task.Run(() => ImagePreviewDataUrl.Create(LastFileBytes, LastContentType));
                var dim = await JS.InvokeAsync<DimResult>("imageResize.loadDataUrl", CanvasId, previewUrl, OrigW, OrigH);
                if (dim == null || dim.width < 1 || dim.height < 1)
                {
                    StatusMessage = L["ErrLoad"];
                    HasImage = false;
                    OrigW = OrigH = 0;
                    return;
                }

                await JS.InvokeAsync<DimResult>(
                    "imageResize.upgradeToFullUpload",
                    CanvasId,
                    $"data:{LastContentType};base64,{Convert.ToBase64String(LastFileBytes)}");
                TargetW = OrigW;
                TargetH = OrigH;
                HasImage = true;
            }
            else
            {
                var dataUrl = $"data:{LastContentType};base64,{Convert.ToBase64String(LastFileBytes)}";
                var dim = await JS.InvokeAsync<DimResult>("imageResize.loadDataUrl", CanvasId, dataUrl);
                if (dim == null || dim.width < 1 || dim.height < 1)
                {
                    StatusMessage = L["ErrLoad"];
                    HasImage = false;
                    OrigW = OrigH = 0;
                    return;
                }

                OrigW = dim.width;
                OrigH = dim.height;
                TargetW = OrigW;
                TargetH = OrigH;
                HasImage = true;
            }
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrReadImage", ex.Message];
            HasImage = false;
            LastFileBytes = Array.Empty<byte>();
            OrigW = OrigH = 0;
        }
        finally
        {
            Busy = false;
        }
    }

    private void OnWidthInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var w) || w < 1)
        {
            return;
        }

        w = Math.Clamp(w, 1, 16384);
        TargetW = w;
        if (MaintainAspect && OrigW > 0 && OrigH > 0)
        {
            TargetH = Math.Max(1, (int)Math.Round(w * (double)OrigH / OrigW));
            TargetH = Math.Clamp(TargetH, 1, 16384);
        }
    }

    private void OnHeightInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var h) || h < 1)
        {
            return;
        }

        h = Math.Clamp(h, 1, 16384);
        TargetH = h;
        if (MaintainAspect && OrigW > 0 && OrigH > 0)
        {
            TargetW = Math.Max(1, (int)Math.Round(h * (double)OrigW / OrigH));
            TargetW = Math.Clamp(TargetW, 1, 16384);
        }
    }

    private Task OnMaintainAspectAfterAsync()
    {
        if (MaintainAspect && OrigW > 0 && OrigH > 0)
        {
            TargetH = Math.Max(1, (int)Math.Round(TargetW * (double)OrigH / OrigW));
            TargetH = Math.Clamp(TargetH, 1, 16384);
        }

        return Task.CompletedTask;
    }

    private async Task ApplyPercentAsync(int percent)
    {
        if (!HasImage || OrigW <= 0 || Busy)
        {
            return;
        }

        var f = percent / 100.0;
        TargetW = Math.Max(1, Math.Min(16384, (int)Math.Round(OrigW * f)));
        TargetH = Math.Max(1, Math.Min(16384, (int)Math.Round(OrigH * f)));
        await ApplyResizeAsync();
    }

    private async Task ApplyResizeAsync()
    {
        if (!HasImage || LastFileBytes.Length == 0)
        {
            return;
        }

        StatusMessage = "";
        Busy = true;
        try
        {
            var res = await JS.InvokeAsync<OkResult>("imageResize.applyResize", CanvasId, TargetW, TargetH);
            if (res == null || !res.ok)
            {
                StatusMessage = L["ErrApply"];
            }
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrApplyDetail", ex.Message];
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task RestoreOriginalAsync()
    {
        StatusMessage = "";
        Busy = true;
        try
        {
            var res = await JS.InvokeAsync<DimOkResult>("imageResize.restoreOriginalSize", CanvasId);
            if (res == null || !res.ok)
            {
                StatusMessage = L["ErrRestore"];
                return;
            }

            if (res.width > 0 && res.height > 0)
            {
                TargetW = res.width;
                TargetH = res.height;
            }
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrRestoreDetail", ex.Message];
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task DownloadAsync()
    {
        StatusMessage = "";
        try
        {
            var ext = OutputMime switch
            {
                "image/jpeg" => ".jpg",
                "image/webp" => ".webp",
                _ => ".png"
            };
            var name = $"resized-{DateTime.Now:yyyyMMdd-HHmmss}{ext}";
            await JS.InvokeVoidAsync("imageResize.download", CanvasId, name, OutputMime, 0.92);
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrDownload", ex.Message];
        }
    }

    private async Task ClearAllAsync()
    {
        StatusMessage = "";
        HasImage = false;
        LastFileBytes = Array.Empty<byte>();
        OrigW = OrigH = 0;
        TargetW = TargetH = 1;
        await JS.InvokeVoidAsync("imageResize.reset", CanvasId);
    }

    private sealed class DimResult
    {
        public int width { get; set; }
        public int height { get; set; }
    }

    private sealed class OkResult
    {
        public bool ok { get; set; }
    }

    private sealed class DimOkResult
    {
        public bool ok { get; set; }
        public int width { get; set; }
        public int height { get; set; }
    }
}
