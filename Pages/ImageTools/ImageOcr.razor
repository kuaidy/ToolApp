@page "/imagetools/imageocr"
@using System.IO
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using ToolApp.Common
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject IStringLocalizer<ImageOcr> L

<div class="tool-page it-page">
    <header class="it-hero">
        <h1>@L["PageTitle"]</h1>
        <p>@L["LeadShort"]</p>
    </header>

    <div class="it-studio">
        @if (UploadedBytes.Length == 0)
        {
            <label class="it-dropzone it-dropzone--in-studio @(Recognizing ? "it-dropzone--disabled" : "")">
                <span class="it-dropzone-icon" aria-hidden="true">+</span>
                <span class="it-dropzone-title">@L["PageTitle"]</span>
                <span class="it-dropzone-hint">@L["DropzoneHint"]</span>
                <InputFile OnChange="OnFileSelectedAsync" accept="image/*" class="it-dropzone-input" disabled="@Recognizing" />
            </label>
        }
        else
        {
            <div class="it-toolbar">
                <div class="it-toolbar-fields">
                    <div class="it-field">
                        <span class="it-field-label">@L["LabelLanguage"]</span>
                        <select class="form-select form-select-sm" @bind="SelectedLanguage" @bind:after="OnLanguageChanged" disabled="@Recognizing">
                            <option value="chi_sim+eng">@L["LangChiSimEng"]</option>
                            <option value="chi_sim">@L["LangChiSim"]</option>
                            <option value="chi_tra+eng">@L["LangChiTraEng"]</option>
                            <option value="chi_tra">@L["LangChiTra"]</option>
                            <option value="eng">@L["LangEng"]</option>
                            <option value="jpn">@L["LangJpn"]</option>
                            <option value="kor">@L["LangKor"]</option>
                        </select>
                    </div>
                    <span class="it-meta mb-0">@L["LanguageHint"]</span>
                </div>
                <div class="it-toolbar-actions">
                    <button type="button" class="it-btn it-btn-outline"
                            @onclick="RecognizeAgainAsync"
                            disabled="@Recognizing">@L["BtnRecognizeAgain"]</button>
                    <button type="button" class="it-btn it-btn-outline"
                            @onclick="CopyResultAsync"
                            disabled="@(Recognizing || string.IsNullOrWhiteSpace(ResultText))">@L["BtnCopy"]</button>
                    <button type="button" class="it-btn it-btn-outline"
                            @onclick="ClearAll">@L["BtnClear"]</button>
                </div>
            </div>

            @if (Recognizing)
            {
                <div class="it-message it-message--busy" role="status">@L["BusyRecognizing"]</div>
            }
            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <div class="it-message it-message--error" role="alert">@StatusMessage</div>
            }

            <div class="it-split">
                <div class="it-panel">
                    <div class="it-panel-head">@L["PreviewHeading"]</div>
                    <div class="it-panel-body">
                        @if (PreviewBusy)
                        {
                            <span class="it-viewport-empty">@L["PreviewGenerating"]</span>
                        }
                        else if (!string.IsNullOrEmpty(PreviewDataUrl))
                        {
                            <img src="@PreviewDataUrl" alt="@L["PreviewAlt"]" decoding="async" />
                        }
                        else
                        {
                            <span class="it-viewport-empty">@L["PreviewEmpty"]</span>
                        }
                    </div>
                </div>
                <div class="it-panel">
                    <div class="it-panel-head">@L["ResultHeading"]</div>
                    <div class="it-panel-body" style="align-items:stretch;">
                        <textarea id="ocr-result-text"
                                  class="font-monospace"
                                  rows="14"
                                  placeholder="@(Recognizing ? L["PlaceholderRecognizing"].Value : L["ResultPlaceholder"].Value)"
                                  style="white-space:pre-wrap;"
                                  value="@ResultText"
                                  @oninput="OnResultInput"
                                  @key="ResultRevision"></textarea>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private const long MaxFileSize = 12 * 1024 * 1024;

    private string SelectedLanguage { get; set; } = "chi_sim+eng";
    private int ResultRevision { get; set; }
    private string ResultText { get; set; } = "";
    private string PreviewDataUrl { get; set; } = "";
    private string StatusMessage { get; set; } = "";
    /// <summary>OCR 进行中；与预览生成分开，选图后可先看到图再识别。</summary>
    private bool Recognizing { get; set; }
    /// <summary>缩略图编码中（很短）；与 OCR 无关。</summary>
    private bool PreviewBusy { get; set; }
    private long _ocrSession;

    private long BeginNewOcrSession() => Interlocked.Increment(ref _ocrSession);
    private byte[] UploadedBytes { get; set; } = Array.Empty<byte>();
    private string UploadedContentType { get; set; } = "image/png";

    private string TessDataPath
    {
        get
        {
            var fromBase = Path.Combine(AppContext.BaseDirectory, "tessdata");
            if (Directory.Exists(fromBase))
            {
                return fromBase;
            }

            var fromContentRoot = Path.Combine(Env.ContentRootPath, "tessdata");
            return Directory.Exists(fromContentRoot) ? fromContentRoot : fromBase;
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        StatusMessage = "";
        var file = e.File;
        if (file == null)
        {
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            UploadedBytes = ms.ToArray();
            UploadedContentType = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;

            var session = BeginNewOcrSession();
            PreviewBusy = true;
            PreviewDataUrl = "";
            await InvokeAsync(StateHasChanged);

            try
            {
                PreviewDataUrl = await Task.Run(() => ImagePreviewDataUrl.Create(UploadedBytes, UploadedContentType));
            }
            finally
            {
                PreviewBusy = false;
            }

            await InvokeAsync(StateHasChanged);

            await RunOcrForSessionAsync(session);
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrReadImage", FormatUserFacingError(ex)];
            UploadedBytes = Array.Empty<byte>();
            PreviewDataUrl = "";
            PreviewBusy = false;
            return;
        }
    }

    private async Task RecognizeAgainAsync()
    {
        if (UploadedBytes.Length == 0)
        {
            StatusMessage = L["ErrPickFirst"];
            return;
        }

        var session = BeginNewOcrSession();
        await RunOcrForSessionAsync(session);
    }

    private void OnLanguageChanged()
    {
        if (UploadedBytes.Length > 0 && !Recognizing)
        {
            _ = RecognizeAgainAsync();
        }
    }

    private async Task RunOcrForSessionAsync(long session)
    {
        if (UploadedBytes.Length == 0)
        {
            return;
        }

        StatusMessage = "";
        Recognizing = true;
        ResultText = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            var text = await Task.Run(() => TesseractOcr.Recognize(UploadedBytes, SelectedLanguage, TessDataPath));
            if (session != _ocrSession)
            {
                return;
            }

            var display = string.IsNullOrWhiteSpace(text) ? L["EmptyOcrResult"].Value : text;
            await InvokeAsync(() =>
            {
                if (session != _ocrSession)
                {
                    return;
                }

                ResultText = display ?? "";
                ResultRevision++;
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            if (session != _ocrSession)
            {
                return;
            }

            StatusMessage = L["ErrRecognize", FormatUserFacingError(ex)];
            ResultText = "";
            ResultRevision++;
        }
        finally
        {
            if (session == _ocrSession)
            {
                Recognizing = false;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnResultInput(ChangeEventArgs e)
    {
        ResultText = e.Value?.ToString() ?? "";
    }

    private async Task CopyResultAsync()
    {
        StatusMessage = "";
        if (string.IsNullOrWhiteSpace(ResultText))
        {
            return;
        }
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ResultText);
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrCopy", FormatUserFacingError(ex)];
        }
    }

    /// <summary>
    /// 展示最内层异常信息（Tesseract/反射常把真实原因放在 InnerException，外层多为 “target of an invocation”）。
    /// </summary>
    private static string FormatUserFacingError(Exception ex)
    {
        var e = ex;
        while (e != null)
        {
            if (e is AggregateException agg && agg.InnerExceptions.Count > 0)
            {
                e = agg.InnerExceptions[0];
                continue;
            }

            if (e.InnerException != null)
            {
                e = e.InnerException;
                continue;
            }

            return string.IsNullOrWhiteSpace(e.Message) ? ex.Message : e.Message;
        }

        return ex.Message;
    }

    private void ClearAll()
    {
        BeginNewOcrSession();
        Recognizing = false;
        PreviewBusy = false;
        ResultText = "";
        ResultRevision++;
        PreviewDataUrl = "";
        UploadedBytes = Array.Empty<byte>();
        UploadedContentType = "image/png";
        StatusMessage = "";
    }
}
