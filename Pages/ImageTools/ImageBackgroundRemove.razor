@page "/imagetools/bgremove"
@using System.IO
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Forms
@using ToolApp.Common
@inject IJSRuntime JS
@inject IStringLocalizer<ImageBackgroundRemove> L

<div class="tool-page it-page">
    <header class="it-hero">
        <h1>@L["PageTitle"]</h1>
        <p>@L["LeadShort"]</p>
    </header>

    <div class="it-studio">
        @if (!HasImage)
        {
            <label class="it-dropzone it-dropzone--in-studio @(Busy ? "it-dropzone--disabled" : "")">
                <span class="it-dropzone-icon" aria-hidden="true">+</span>
                <span class="it-dropzone-title">@L["PageTitle"]</span>
                <span class="it-dropzone-hint">@L["DropzoneHint"]</span>
                <InputFile OnChange="OnFileSelectedAsync" accept="image/*" class="it-dropzone-input" disabled="@Busy" />
            </label>
        }
        else
        {
            <div class="it-toolbar">
                <div class="it-toolbar-fields">
                    <div class="it-field">
                        <span class="it-field-label">@L["SectionMode"]</span>
                        <div class="it-radio-row">
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="bgmode" checked="@(Mode == "quick")" @onchange="@(_ => Mode = "quick")" disabled="@Busy" />
                                <span>@L["ModeQuick"]</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="bgmode" checked="@(Mode == "color")" @onchange="@(_ => Mode = "color")" disabled="@Busy" />
                                <span>@L["ModeColor"]</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="bgmode" checked="@(Mode == "ai")" @onchange="@(_ => Mode = "ai")" disabled="@Busy" />
                                <span>@L["ModeAi"]</span>
                            </label>
                        </div>
                    </div>

                    @if (Mode == "quick")
                    {
                        <div class="it-field it-field--gap">
                            <span class="it-field-label">@L["LabelTolerance", Tolerance]</span>
                            <input type="range" class="form-range" min="1" max="100" step="1" @bind="Tolerance" @bind:event="oninput" disabled="@Busy" />
                        </div>
                    }
                    else if (Mode == "color")
                    {
                        <div class="it-options-row">
                            <span class="it-options-label">@L["LabelKeyColor"]</span>
                            <input type="color" class="it-color-input" @bind="KeyColor" disabled="@Busy" />
                        </div>
                        <div class="it-field it-field--gap">
                            <span class="it-field-label">@L["LabelTolerance", Tolerance]</span>
                            <input type="range" class="form-range" min="1" max="100" step="1" @bind="Tolerance" @bind:event="oninput" disabled="@Busy" />
                        </div>
                        <div class="it-field it-field--gap">
                            <span class="it-field-label">@L["LabelSoftBand", SoftBand]</span>
                            <input type="range" class="form-range" min="0" max="60" step="1" @bind="SoftBand" @bind:event="oninput" disabled="@Busy" />
                        </div>
                    }
                    else
                    {
                        <span class="it-meta mb-0">@L["AiNoteShort"]</span>
                    }
                </div>

                <div class="it-toolbar-actions">
                    <button type="button" class="it-btn it-btn-primary"
                            @onclick="RemoveBackgroundAsync"
                            disabled="@Busy">
                        @(Mode == "ai" ? L["BtnAiRemove"] : L["BtnQuickRemove"])
                    </button>
                    <button type="button" class="it-btn it-btn-outline"
                            @onclick="DownloadAsync"
                            disabled="@(Busy || !HasResult)">@L["BtnDownloadPng"]</button>
                    <button type="button" class="it-btn it-btn-outline"
                            @onclick="ClearAll">@L["BtnClear"]</button>
                </div>
            </div>

            @if (Busy)
            {
                <div class="it-message it-message--busy" role="status">
                    @(Mode == "ai" ? L["BusyAi"] : L["BusyQuick"])
                </div>
            }
            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <div class="it-message it-message--error" role="alert">@StatusMessage</div>
            }
        }

        @* canvas 必须始终在 DOM 中（固定 id），否则选图后先调 JS 再置 HasImage 会报 canvas not found *@
        <div class="it-viewport it-viewport--checker @(HasImage ? "" : "it-viewport--hidden")">
            <div class="it-viewport-canvas">
                <canvas id="@CanvasId"></canvas>
            </div>
            @if (Busy && HasImage)
            {
                <div class="it-viewport-overlay it-viewport-overlay--light">@(Mode == "ai" ? L["BusyAi"] : L["BusyQuick"])</div>
            }
        </div>
    </div>

    <section class="it-features">
        <p class="it-features-desc">@L["Lead"]</p>
    </section>
</div>

@code {
    private const string CanvasId = "image-bg-remove-canvas";
    private const long MaxFileSize = 12 * 1024 * 1024;

    private string Mode { get; set; } = "quick";
    private int Tolerance { get; set; } = 42;
    private int SoftBand { get; set; } = 18;
    private string KeyColor { get; set; } = "#ffffff";
    private bool Busy { get; set; }
    private bool HasImage { get; set; }
    private bool HasResult { get; set; }
    private string StatusMessage { get; set; } = "";
    private byte[] LastFileBytes { get; set; } = Array.Empty<byte>();
    private string LastContentType { get; set; } = "image/png";

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        StatusMessage = "";
        HasResult = false;
        var file = e.File;
        if (file == null)
        {
            return;
        }

        Busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            LastFileBytes = ms.ToArray();
            LastContentType = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;

            if (ImagePreviewDataUrl.TryGetDimensions(LastFileBytes, out var ow, out var oh))
            {
                var previewUrl = await Task.Run(() => ImagePreviewDataUrl.Create(LastFileBytes, LastContentType));
                await JS.InvokeVoidAsync("imageBackgroundRemove.loadDataUrl", CanvasId, previewUrl, ow, oh);
                await JS.InvokeVoidAsync(
                    "imageBackgroundRemove.upgradeToFullUpload",
                    CanvasId,
                    $"data:{LastContentType};base64,{Convert.ToBase64String(LastFileBytes)}");
            }
            else
            {
                var dataUrl = $"data:{LastContentType};base64,{Convert.ToBase64String(LastFileBytes)}";
                await JS.InvokeVoidAsync("imageBackgroundRemove.loadDataUrl", CanvasId, dataUrl);
            }

            HasImage = true;
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrReadImage", ex.Message];
            HasImage = false;
            LastFileBytes = Array.Empty<byte>();
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ReloadSourceToCanvasAsync()
    {
        if (LastFileBytes.Length == 0)
        {
            return;
        }
        var dataUrl = $"data:{LastContentType};base64,{Convert.ToBase64String(LastFileBytes)}";
        await JS.InvokeVoidAsync("imageBackgroundRemove.upgradeToFullUpload", CanvasId, dataUrl);
    }

    private async Task RemoveBackgroundAsync()
    {
        if (!HasImage || LastFileBytes.Length == 0)
        {
            return;
        }
        StatusMessage = "";
        Busy = true;
        try
        {
            RemoveResult res;

            if (Mode == "ai")
            {
                res = await JS.InvokeAsync<RemoveResult>("imageBackgroundRemove.removeBackgroundAi", CanvasId, LastFileBytes, LastContentType);
            }
            else
            {
                await ReloadSourceToCanvasAsync();
                if (Mode == "quick")
                {
                    res = await JS.InvokeAsync<RemoveResult>("imageBackgroundRemove.removeBackground", CanvasId, Tolerance);
                }
                else
                {
                    res = await JS.InvokeAsync<RemoveResult>("imageBackgroundRemove.removeByColor", CanvasId, KeyColor, Tolerance, SoftBand);
                }
            }

            if (res == null || !res.ok)
            {
                StatusMessage = Mode == "ai"
                    ? L["ErrAiFailed"]
                    : L["ErrProcessFailed"];
                HasResult = false;
                return;
            }
            HasResult = true;
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrProcess", ex.Message];
            HasResult = false;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task DownloadAsync()
    {
        StatusMessage = "";
        try
        {
            var name = $"no-bg-{DateTime.Now:yyyyMMdd-HHmmss}.png";
            await JS.InvokeVoidAsync("imageBackgroundRemove.download", CanvasId, name);
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrDownload", ex.Message];
        }
    }

    private async Task ClearAll()
    {
        StatusMessage = "";
        HasImage = false;
        HasResult = false;
        LastFileBytes = Array.Empty<byte>();
        await JS.InvokeVoidAsync("imageBackgroundRemove.reset", CanvasId);
    }

    private sealed class RemoveResult
    {
        public bool ok { get; set; }
        public string error { get; set; } = "";
    }
}