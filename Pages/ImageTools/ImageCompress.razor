@page "/imagetools/imagecompress"
@using System.IO
@using System.Net.Http
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using ToolApp.Controllers
@using ToolApp.Services
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IStringLocalizer<ImageCompress> L

<div class="tool-page">
    <h2>@L["PageTitle"]</h2>
    <p class="tool-lead">@L["Lead"]</p>

    <div class="tool-section">
        <div class="tool-section-title">@L["SectionUpload"]</div>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-8">
                <div class="tool-field-col">
                    <span class="tool-form-label">@L["LabelPickImage"]</span>
                    <InputFile OnChange="OnFileSelectedAsync" accept="image/*" class="form-control" disabled="@Busy" />
                </div>
            </div>
        </div>
        @if (OrigW > 0)
        {
            <p class="tool-note mt-3 mb-0">@L["OriginalInfo", OrigW, OrigH, FormatSize(OriginalBytes)]</p>
        }
    </div>

    <div class="tool-section">
        <div class="tool-section-title">@L["SectionOptions"]</div>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <div class="tool-field-col">
                    <span class="tool-form-label">@L["LabelOutputFormat"]</span>
                    <select class="form-select" value="@OutputMime" @onchange="OnOutputMimeChange" disabled="@(!HasImage || Busy)">
                        <option value="image/jpeg">JPEG</option>
                        <option value="image/webp">WebP</option>
                        <option value="image/png">PNG</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-8">
                <div class="tool-field-col">
                    <span class="tool-form-label">@L["LabelQuality", QualityPercent / 10]</span>
                    <input type="range" class="form-range tool-range" min="10" max="100" step="10"
                           @bind="QualityPercent" @bind:event="oninput" @bind:after="NormalizeQualityBinding"
                           disabled="@(!HasImage || Busy)" />
                </div>
            </div>
        </div>
        @if (!IsPngOutput)
        {
            <label class="form-check d-block mt-3">
                <InputCheckbox @bind-Value="FillWhiteBackground" class="form-check-input" disabled="@(!HasImage || Busy)" />
                <span>@L["LabelFillWhite"]</span>
            </label>
        }

        <div class="tool-btn-row mt-section">
            <button type="button" class="btn btn-primary"
                    @onclick="CompressAsync"
                    disabled="@(Busy || !HasImage)">@L["BtnCompress"]</button>
            <button type="button" class="btn btn-outline-secondary"
                    @onclick="RestorePreviewAsync"
                    disabled="@(Busy || !HasImage)">@L["BtnRestorePreview"]</button>
            <button type="button" class="btn btn-outline-secondary"
                    @onclick="DownloadAsync"
                    disabled="@(Busy || !HasImage || !HasCompressedPreview)">@L["BtnDownload"]</button>
            <button type="button" class="btn btn-outline-secondary"
                    @onclick="ClearAllAsync">@L["BtnClear"]</button>
        </div>

        @if (CompressedBytes.HasValue && OriginalBytes > 0)
        {
            <p class="tool-note mt-3 mb-0">
                @L["ResultStats", FormatSize(CompressedBytes.Value), FormatRatio(OriginalBytes, CompressedBytes.Value)]
            </p>
        }
    </div>

    @if (Busy)
    {
        <div class="tool-message tool-message--busy" role="status">@L["Busy"]</div>
    }

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="tool-message tool-message--error" role="alert">@StatusMessage</div>
    }

    @if (!IsPngOutput)
    {
        <p class="tool-note small">@L["NoteLossyAlpha"]</p>
    }

    <div class="tool-section mb-0">
        <div class="tool-section-title">@L["SectionPreview"]</div>
        <div class="tool-checkerboard @(HasImage ? "" : "justify-content-center")" style="min-height:160px;">
            <canvas id="@CanvasId" class="@(HasImage ? "" : "d-none")" style="max-width:100%;height:auto;"></canvas>
            @if (!HasImage)
            {
                <span class="text-muted small">@L["PreviewEmpty"]</span>
            }
        </div>
    </div>
</div>

@code {
    private const string CanvasId = "image-compress-canvas";
    private const long MaxFileSize = 20 * 1024 * 1024;

    private static readonly JsonSerializerOptions JsonReadOptions = new() { PropertyNameCaseInsensitive = true };

    private bool Busy { get; set; }
    private bool HasImage { get; set; }
    private bool HasCompressedPreview { get; set; }
    private string StatusMessage { get; set; } = "";
    private byte[] LastFileBytes { get; set; } = Array.Empty<byte>();
    private string LastContentType { get; set; } = "image/png";
    private int OrigW { get; set; }
    private int OrigH { get; set; }
    private int OriginalBytes { get; set; }
    private int QualityPercent { get; set; } = 80;
    private string OutputMime { get; set; } = "image/jpeg";
    private bool FillWhiteBackground { get; set; } = true;
    private string ServerResultBase64 { get; set; } = "";
    private string ServerResultMime { get; set; } = "";

    private bool IsPngOutput => string.Equals(OutputMime, "image/png", StringComparison.OrdinalIgnoreCase);

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:0.##} KB";
        }

        return $"{bytes / (1024.0 * 1024):0.##} MB";
    }

    private static string FormatRatio(long original, long compressed)
    {
        if (original <= 0)
        {
            return "—";
        }

        var pct = compressed * 100.0 / original;
        return $"{pct:0.#}%";
    }

    private void ClearServerResult()
    {
        ServerResultBase64 = "";
        ServerResultMime = "";
    }

    private Task NormalizeQualityBinding()
    {
        QualityPercent = ImageSharpCompressService.NormalizeQualityStep10(QualityPercent);
        return Task.CompletedTask;
    }

    private void OnOutputMimeChange(ChangeEventArgs e)
    {
        OutputMime = e.Value?.ToString() ?? "image/jpeg";
        HasCompressedPreview = false;
        CompressedBytes = null;
        ClearServerResult();
    }

    private long? CompressedBytes { get; set; }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        StatusMessage = "";
        HasCompressedPreview = false;
        CompressedBytes = null;
        ClearServerResult();
        var file = e.File;
        if (file == null)
        {
            return;
        }

        Busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            LastFileBytes = ms.ToArray();
            OriginalBytes = LastFileBytes.Length;
            LastContentType = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;
            var dataUrl = $"data:{LastContentType};base64,{Convert.ToBase64String(LastFileBytes)}";
            var dim = await JS.InvokeAsync<DimResult>("imageCompress.loadDataUrl", CanvasId, dataUrl);
            if (dim == null || dim.width < 1 || dim.height < 1)
            {
                StatusMessage = L["ErrLoad"];
                HasImage = false;
                OrigW = OrigH = 0;
                OriginalBytes = 0;
                return;
            }

            OrigW = dim.width;
            OrigH = dim.height;
            HasImage = true;
            HasCompressedPreview = false;
            CompressedBytes = null;
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrReadImage", ex.Message];
            HasImage = false;
            LastFileBytes = Array.Empty<byte>();
            OrigW = OrigH = 0;
            OriginalBytes = 0;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task CompressAsync()
    {
        if (!HasImage || LastFileBytes.Length == 0)
        {
            return;
        }

        StatusMessage = "";
        Busy = true;
        try
        {
            var http = HttpClientFactory.CreateClient();
            var uri = Nav.ToAbsoluteUri("/api/imagetools/imagecompress/compress");
            using var form = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(LastFileBytes);
            fileContent.Headers.ContentType = MediaTypeHeaderValue.Parse(
                string.IsNullOrWhiteSpace(LastContentType) ? "application/octet-stream" : LastContentType);
            form.Add(fileContent, "file", "upload");
            form.Add(new StringContent(OutputMime), "mime");
            var q = ImageSharpCompressService.NormalizeQualityStep10(QualityPercent);
            form.Add(new StringContent(q.ToString()), "quality");
            form.Add(new StringContent(FillWhiteBackground ? "true" : "false"), "fillBackground");

            using var resp = await http.PostAsync(uri, form);
            var body = await resp.Content.ReadFromJsonAsync<CompressApiResponse>(JsonReadOptions);
            if (body == null)
            {
                StatusMessage = L["ErrCompress"];
                HasCompressedPreview = false;
                CompressedBytes = null;
                ClearServerResult();
                return;
            }

            if (!body.Ok)
            {
                StatusMessage = string.IsNullOrWhiteSpace(body.Error) ? L["ErrCompress"] : body.Error;
                HasCompressedPreview = false;
                CompressedBytes = null;
                ClearServerResult();
                return;
            }

            if (string.IsNullOrEmpty(body.Base64))
            {
                StatusMessage = L["ErrCompress"];
                HasCompressedPreview = false;
                CompressedBytes = null;
                ClearServerResult();
                return;
            }

            ServerResultBase64 = body.Base64;
            ServerResultMime = string.IsNullOrEmpty(body.MimeType) ? OutputMime : body.MimeType;
            CompressedBytes = body.CompressedBytes > 0 ? body.CompressedBytes : 0L;
            HasCompressedPreview = true;

            var previewUrl = $"data:{ServerResultMime};base64,{ServerResultBase64}";
            await JS.InvokeAsync<DimResult>("imageCompress.loadDataUrl", CanvasId, previewUrl);
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrCompressDetail", ex.Message];
            HasCompressedPreview = false;
            CompressedBytes = null;
            ClearServerResult();
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task RestorePreviewAsync()
    {
        StatusMessage = "";
        Busy = true;
        try
        {
            var res = await JS.InvokeAsync<OkResult>("imageCompress.restoreOriginal", CanvasId);
            if (res == null || !res.ok)
            {
                StatusMessage = L["ErrRestore"];
                return;
            }

            HasCompressedPreview = false;
            CompressedBytes = null;
            ClearServerResult();
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrRestoreDetail", ex.Message];
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task DownloadAsync()
    {
        StatusMessage = "";
        try
        {
            var ext = OutputMime switch
            {
                "image/jpeg" => ".jpg",
                "image/webp" => ".webp",
                _ => ".png"
            };
            var name = $"compressed-{DateTime.Now:yyyyMMdd-HHmmss}{ext}";
            var mime = string.IsNullOrEmpty(ServerResultMime) ? OutputMime : ServerResultMime;
            await JS.InvokeVoidAsync("imageCompress.downloadBase64", ServerResultBase64, mime, name);
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrDownload", ex.Message];
        }
    }

    private async Task ClearAllAsync()
    {
        StatusMessage = "";
        HasImage = false;
        HasCompressedPreview = false;
        CompressedBytes = null;
        LastFileBytes = Array.Empty<byte>();
        OrigW = OrigH = 0;
        OriginalBytes = 0;
        ClearServerResult();
        await JS.InvokeVoidAsync("imageCompress.reset", CanvasId);
    }

    private sealed class DimResult
    {
        public int width { get; set; }
        public int height { get; set; }
    }

    private sealed class OkResult
    {
        public bool ok { get; set; }
    }
}
