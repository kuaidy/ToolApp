@page "/imagetools/imagecompress"
@using System.IO
@using System.Threading
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using SixLabors.ImageSharp
@using ToolApp.Common
@using ToolApp.Services
@inject IJSRuntime JS
@inject IStringLocalizer<ImageCompress> L

<div class="tool-page it-page">
    <header class="it-hero">
        <h1>@L["PageTitle"]</h1>
        <p>@L["LeadShort"]</p>
    </header>

    <div class="it-studio">
        @if (!HasImage)
        {
            <label class="it-dropzone it-dropzone--in-studio @(Busy ? "it-dropzone--disabled" : "")">
                <span class="it-dropzone-icon" aria-hidden="true">+</span>
                <span class="it-dropzone-title">@L["PageTitle"]</span>
                <span class="it-dropzone-hint">@L["DropzoneHint"]</span>
                <InputFile OnChange="OnFileSelectedAsync" accept="image/*" class="it-dropzone-input" disabled="@Busy" />
            </label>
        }
        else
        {
            <div class="it-toolbar">
                <div class="it-toolbar-fields">
                    <div class="it-field">
                        <span class="it-field-label">@L["LabelOutputFormat"]</span>
                        <select class="form-select form-select-sm" value="@OutputMime" @onchange="OnOutputMimeChange" disabled="@Busy">
                            <option value="image/jpeg">JPEG</option>
                            <option value="image/webp">WebP</option>
                            <option value="image/png">PNG</option>
                        </select>
                    </div>
                    <div class="it-field it-field--gap">
                        <span class="it-field-label">@L["LabelQuality", QualityPercent / 10]</span>
                        <input type="range" class="form-range" min="10" max="100" step="10"
                               @bind="QualityPercent" @bind:event="oninput" @bind:after="NormalizeQualityBinding"
                               disabled="@Busy" />
                    </div>
                    @if (!IsPngOutput)
                    {
                        <label class="form-check">
                            <InputCheckbox @bind-Value="FillWhiteBackground" class="form-check-input" disabled="@Busy" />
                            <span class="form-check-label">@L["LabelFillWhite"]</span>
                        </label>
                    }
                </div>
                <div class="it-toolbar-actions">
                    <button type="button" class="it-btn it-btn-primary"
                            @onclick="CompressAsync"
                            disabled="@Busy">@L["BtnCompress"]</button>
                    <button type="button" class="it-btn it-btn-outline"
                            @onclick="RestorePreviewAsync"
                            disabled="@Busy">@L["BtnRestorePreview"]</button>
                    <button type="button" class="it-btn it-btn-outline"
                            @onclick="DownloadAsync"
                            disabled="@(Busy || !HasCompressedPreview)">@L["BtnDownload"]</button>
                    <button type="button" class="it-btn it-btn-outline"
                            @onclick="ClearAllAsync">@L["BtnClear"]</button>
                </div>
            </div>

            @if (OrigW > 0)
            {
                <p class="it-meta mb-2">@L["OriginalInfo", OrigW, OrigH, FormatSize(OriginalBytes)]</p>
            }
            @if (CompressedBytes.HasValue && OriginalBytes > 0)
            {
                <p class="it-meta mb-2">@L["ResultStats", FormatSize(CompressedBytes.Value), FormatRatio(OriginalBytes, CompressedBytes.Value)]</p>
            }
            @if (Busy)
            {
                <div class="it-message it-message--busy" role="status">@L["Busy"]</div>
            }
            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <div class="it-message it-message--error" role="alert">@StatusMessage</div>
            }
            @if (!IsPngOutput)
            {
                <p class="it-note mb-2">@L["NoteLossyAlpha"]</p>
            }
        }

        <div class="it-viewport it-viewport--checker @(HasImage ? "" : "it-viewport--hidden")">
            <div class="it-viewport-canvas">
                <canvas id="@CanvasId"></canvas>
            </div>
            @if (Busy && HasImage)
            {
                <div class="it-viewport-overlay it-viewport-overlay--light">@L["Busy"]</div>
            }
        </div>
    </div>

</div>
@code {
    private const string CanvasId = "image-compress-canvas";
    private const long MaxFileSize = 20 * 1024 * 1024;

    private bool Busy { get; set; }
    private bool HasImage { get; set; }
    private bool HasCompressedPreview { get; set; }
    private string StatusMessage { get; set; } = "";
    private byte[] LastFileBytes { get; set; } = Array.Empty<byte>();
    private string LastContentType { get; set; } = "image/png";
    private int OrigW { get; set; }
    private int OrigH { get; set; }
    private int OriginalBytes { get; set; }
    private int QualityPercent { get; set; } = 80;
    private string OutputMime { get; set; } = "image/jpeg";
    private bool FillWhiteBackground { get; set; } = true;
    private string ServerResultBase64 { get; set; } = "";
    private string ServerResultMime { get; set; } = "";

    private bool IsPngOutput => string.Equals(OutputMime, "image/png", StringComparison.OrdinalIgnoreCase);

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:0.##} KB";
        }

        return $"{bytes / (1024.0 * 1024):0.##} MB";
    }

    private static string FormatRatio(long original, long compressed)
    {
        if (original <= 0)
        {
            return "—";
        }

        var pct = compressed * 100.0 / original;
        return $"{pct:0.#}%";
    }

    private void ClearServerResult()
    {
        ServerResultBase64 = "";
        ServerResultMime = "";
    }

    private Task NormalizeQualityBinding()
    {
        QualityPercent = ImageSharpCompressService.NormalizeQualityStep10(QualityPercent);
        return Task.CompletedTask;
    }

    private void OnOutputMimeChange(ChangeEventArgs e)
    {
        OutputMime = e.Value?.ToString() ?? "image/jpeg";
        HasCompressedPreview = false;
        CompressedBytes = null;
        ClearServerResult();
    }

    private long? CompressedBytes { get; set; }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        StatusMessage = "";
        HasCompressedPreview = false;
        CompressedBytes = null;
        ClearServerResult();
        var file = e.File;
        if (file == null)
        {
            return;
        }

        Busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            LastFileBytes = ms.ToArray();
            OriginalBytes = LastFileBytes.Length;
            LastContentType = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;

            if (ImagePreviewDataUrl.TryGetDimensions(LastFileBytes, out var ow, out var oh))
            {
                OrigW = ow;
                OrigH = oh;
                var previewUrl = await Task.Run(() => ImagePreviewDataUrl.Create(LastFileBytes, LastContentType));
                var dim = await JS.InvokeAsync<DimResult>("imageCompress.loadDataUrl", CanvasId, previewUrl, OrigW, OrigH);
                if (dim == null || dim.width < 1 || dim.height < 1)
                {
                    StatusMessage = L["ErrLoad"];
                    HasImage = false;
                    OrigW = OrigH = 0;
                    OriginalBytes = 0;
                    return;
                }

                await JS.InvokeAsync<DimResult>(
                    "imageCompress.upgradeToFullUpload",
                    CanvasId,
                    $"data:{LastContentType};base64,{Convert.ToBase64String(LastFileBytes)}");
                HasImage = true;
            }
            else
            {
                var dataUrl = $"data:{LastContentType};base64,{Convert.ToBase64String(LastFileBytes)}";
                var dim = await JS.InvokeAsync<DimResult>("imageCompress.loadDataUrl", CanvasId, dataUrl);
                if (dim == null || dim.width < 1 || dim.height < 1)
                {
                    StatusMessage = L["ErrLoad"];
                    HasImage = false;
                    OrigW = OrigH = 0;
                    OriginalBytes = 0;
                    return;
                }

                OrigW = dim.width;
                OrigH = dim.height;
                HasImage = true;
            }
            HasCompressedPreview = false;
            CompressedBytes = null;
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrReadImage", ex.Message];
            HasImage = false;
            LastFileBytes = Array.Empty<byte>();
            OrigW = OrigH = 0;
            OriginalBytes = 0;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task CompressAsync()
    {
        if (!HasImage || LastFileBytes.Length == 0)
        {
            return;
        }

        StatusMessage = "";
        Busy = true;
        try
        {
            // Server-side in-process compress (avoid HttpClient loopback to public URL).
            var outputMime = string.IsNullOrWhiteSpace(OutputMime) ? "image/jpeg" : OutputMime.Trim();
            if (!IsAllowedOutputMime(outputMime))
            {
                StatusMessage = L["ErrCompress"];
                HasCompressedPreview = false;
                CompressedBytes = null;
                ClearServerResult();
                return;
            }

            var q = ImageSharpCompressService.NormalizeQualityStep10(QualityPercent);
            await using var input = new MemoryStream(LastFileBytes, writable: false);
            byte[] bytes;
            try
            {
                bytes = await ImageSharpCompressService.CompressAsync(
                    input,
                    outputMime,
                    q,
                    FillWhiteBackground,
                    CancellationToken.None);
            }
            catch (UnknownImageFormatException)
            {
                StatusMessage = L["ErrLoad"];
                HasCompressedPreview = false;
                CompressedBytes = null;
                ClearServerResult();
                return;
            }
            catch (InvalidOperationException ex)
            {
                StatusMessage = string.IsNullOrWhiteSpace(ex.Message) ? L["ErrCompress"] : L["ErrCompressDetail", ex.Message];
                HasCompressedPreview = false;
                CompressedBytes = null;
                ClearServerResult();
                return;
            }

            ServerResultBase64 = Convert.ToBase64String(bytes);
            ServerResultMime = outputMime;
            CompressedBytes = bytes.LongLength;
            HasCompressedPreview = true;

            if (ImagePreviewDataUrl.TryGetDimensions(bytes, out var cw, out var ch))
            {
                var previewUrl = await Task.Run(() => ImagePreviewDataUrl.Create(bytes, ServerResultMime));
                await JS.InvokeAsync<DimResult>("imageCompress.loadDataUrl", CanvasId, previewUrl, cw, ch);
                await JS.InvokeAsync<DimResult>(
                    "imageCompress.upgradeCanvasPreview",
                    CanvasId,
                    $"data:{ServerResultMime};base64,{ServerResultBase64}");
            }
            else
            {
                var previewUrl = $"data:{ServerResultMime};base64,{ServerResultBase64}";
                await JS.InvokeAsync<DimResult>("imageCompress.loadDataUrl", CanvasId, previewUrl);
            }
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrCompressDetail", ex.Message];
            HasCompressedPreview = false;
            CompressedBytes = null;
            ClearServerResult();
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task RestorePreviewAsync()
    {
        StatusMessage = "";
        Busy = true;
        try
        {
            var res = await JS.InvokeAsync<OkResult>("imageCompress.restoreOriginal", CanvasId);
            if (res == null || !res.ok)
            {
                StatusMessage = L["ErrRestore"];
                return;
            }

            HasCompressedPreview = false;
            CompressedBytes = null;
            ClearServerResult();
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrRestoreDetail", ex.Message];
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task DownloadAsync()
    {
        StatusMessage = "";
        try
        {
            var ext = OutputMime switch
            {
                "image/jpeg" => ".jpg",
                "image/webp" => ".webp",
                _ => ".png"
            };
            var name = $"compressed-{DateTime.Now:yyyyMMdd-HHmmss}{ext}";
            var mime = string.IsNullOrEmpty(ServerResultMime) ? OutputMime : ServerResultMime;
            await JS.InvokeVoidAsync("imageCompress.downloadBase64", ServerResultBase64, mime, name);
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrDownload", ex.Message];
        }
    }

    private async Task ClearAllAsync()
    {
        StatusMessage = "";
        HasImage = false;
        HasCompressedPreview = false;
        CompressedBytes = null;
        LastFileBytes = Array.Empty<byte>();
        OrigW = OrigH = 0;
        OriginalBytes = 0;
        ClearServerResult();
        await JS.InvokeVoidAsync("imageCompress.reset", CanvasId);
    }

    private static bool IsAllowedOutputMime(string m) =>
        m.Equals("image/png", StringComparison.OrdinalIgnoreCase)
        || m.Equals("image/jpeg", StringComparison.OrdinalIgnoreCase)
        || m.Equals("image/webp", StringComparison.OrdinalIgnoreCase);

    private sealed class DimResult
    {
        public int width { get; set; }
        public int height { get; set; }
    }

    private sealed class OkResult
    {
        public bool ok { get; set; }
    }
}
