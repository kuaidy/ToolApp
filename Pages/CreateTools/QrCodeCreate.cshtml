@page
@model QrCodeCreateModel
@{
    ViewData["Title"] = "二维码生成";
}
<div class="tool-page it-page ct-page">
    <header class="it-hero">
        <h1>@ViewData["Title"]</h1>
        <p>输入文本或链接，即时生成二维码并下载图片。</p>
    </header>

    <div class="it-studio">
        <div class="it-toolbar">
            <div class="it-toolbar-fields">
                <span class="it-meta mb-0">支持网址、纯文本等内容，生成后可下载 PNG 图片。</span>
            </div>
            <div class="it-toolbar-actions">
                <button type="button" class="it-btn it-btn-primary" onclick="CreateQrCode()">生成</button>
                <button type="button" class="it-btn it-btn-outline" onclick="DownQrCodeImage()">下载</button>
            </div>
        </div>

        <div class="ct-qrcode-workspace">
            <div class="ct-qrcode-input">
                <span class="ct-field-label">内容</span>
                <textarea id="QrCodeInputValue" placeholder="请输入网址或文本内容"></textarea>
            </div>
            <div class="ct-qrcode-view">
                <span class="ct-field-label">预览</span>
                <div id="qrcode"></div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function CreateQrCode(){
        $("#qrcode").empty();
        var qrcode=new QRCode(document.getElementById("qrcode"));
        var inputValue=$("#QrCodeInputValue").val();
        qrcode.clear();
        qrcode.makeCode(inputValue);
    }
    function DownQrCodeImage(){
        var qrcode = document.getElementById('qrcode');
        var img = qrcode.getElementsByTagName('img')[0];
        if (!img) {
            return;
        }
        var url = img.src;
        var a = document.createElement('a');
        var event = new MouseEvent('click');
        var date=new Date();
        var filename=date.getFullYear()+"-"+(date.getMonth()+1)+"-"+date.getDate()+"-"+date.getTime()+".png";
        a.download = filename;
        a.href = url;
        a.dispatchEvent(event);
    }
</script>
