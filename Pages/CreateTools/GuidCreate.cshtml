@page
@model GuidCreateModel
@{
    ViewData["Title"] = "Guid生成";
}
<div class="tool-page it-page ct-page">
    <header class="it-hero">
        <h1>@ViewData["Title"]</h1>
        <p>一键生成全局唯一标识符（GUID / UUID）。</p>
    </header>

    <div class="it-studio">
        <form method="post">
            <div class="it-toolbar">
                <div class="it-toolbar-fields" style="flex:1 1 100%;">
                    <div class="ct-field" style="width:100%;">
                        <span class="ct-field-label">生成的 GUID</span>
                        <input class="form-control ct-guid-display" type="text" readonly value="@ViewData["Guid"]" />
                    </div>
                </div>
                <div class="it-toolbar-actions">
                    <button type="submit" class="it-btn it-btn-primary">生成</button>
                </div>
            </div>
        </form>
    </div>
</div>
