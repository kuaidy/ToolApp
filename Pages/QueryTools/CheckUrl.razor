@page "/QueryTools/CheckUrl"
@using System.Text.RegularExpressions
@using ToolApp.Models
<div class="tool-page div-input">
    <strong>请输入网址</strong>
    <input type="text" name="" id="ip-colorvalue" class="ip-colorvalue" @bind-value="m_BaseUrl">
    <button @onclick="BeginCheck">开始检测</button>
    <input @bind-value="m_IsChecked" type="checkbox" />
    <span>只显示站外链接</span>
    <span>@message</span>
    <table class="table table-bordered border-primary">
        <thead>
            <tr>
                <th>链接</th>
                <th>状态</th>
                <th>结果</th>
            </tr>
        </thead>
        <tbody>
            @foreach (CheckUrlModel checkUrl in m_CheckUrls)
            {
                <tr>
                    <td>@checkUrl.Url</td>
                    @if (@checkUrl.Status == "OK")
                    {
                        <td style="color:green;">
                            @checkUrl.Status
                        </td>
                    }
                    else
                    {
                        <td style="color:red;">
                            @checkUrl.Status
                        </td>
                    }
                    <td>@checkUrl.Result</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@code {
    private string m_BaseUrl;
    private List<CheckUrlModel> m_CheckUrls = new List<CheckUrlModel>();
    private List<CheckUrlModel> m_AllCheckUrls = new List<CheckUrlModel>();
    private string message;
    private bool m_IsChecked;
    private HttpClient m_HttpClient = new HttpClient();
    private async void BeginCheck()
    {
        m_CheckUrls.Clear();
        m_AllCheckUrls.Clear();
        if (!string.IsNullOrEmpty(m_BaseUrl))
        {
            m_HttpClient.Timeout = TimeSpan.FromSeconds(10);
            HttpResponseMessage httpResponseMessage = await m_HttpClient.GetAsync(m_BaseUrl);
            if (httpResponseMessage.StatusCode == System.Net.HttpStatusCode.OK)
            {
                CheckUrlModel checkUrl = new CheckUrlModel();
                checkUrl.Url = m_BaseUrl;
                checkUrl.Status = httpResponseMessage.StatusCode.ToString();
                checkUrl.Result = "正常";
                m_CheckUrls.Add(checkUrl);
                m_AllCheckUrls.Add(checkUrl);
                StateHasChanged();
                await Check(m_BaseUrl);
            }
        }
        if (m_IsChecked)
        {
            message = $"检测完毕，共检测{m_CheckUrls.Count}条。";
        }
        else
        {
            message = $"检测完毕，共检测{m_AllCheckUrls.Count}条。";
        }
        StateHasChanged();
    }
    private async Task Check(string url)
    {
        string pattern = $"^/.+";
        bool res = Regex.IsMatch(url, pattern);
        if (res)
        {
            url = m_BaseUrl + url;
        }
        if (url != "/")
        {
            pattern = $"^(https|http)://[^\\s/$.?#].[^\\s]*$";
            res = Regex.IsMatch(url, pattern);
            if (res)
            {
                string content = await m_HttpClient.GetStringAsync(url);
                if (!string.IsNullOrEmpty(content))
                {
                    pattern = $"href=\"([http://|https://].*?)\"";
                    MatchCollection matchCollection = Regex.Matches(content, pattern);
                    foreach (Match match in matchCollection)
                    {

                        string tmpUrl = match.Groups[1].Value.Trim();
                        if (m_AllCheckUrls.Any(x => x.Url == tmpUrl || x.Url == $"{tmpUrl}/")) continue;
                        if (!tmpUrl.Contains(m_BaseUrl))
                        {
                            try
                            {
                                HttpResponseMessage tmpHttpResponseMessage = await m_HttpClient.GetAsync(tmpUrl);
                                if (tmpHttpResponseMessage != null)
                                {
                                    CheckUrlModel tmpCheckUrl = new CheckUrlModel();
                                    tmpCheckUrl.Url = tmpUrl;
                                    tmpCheckUrl.Status = tmpHttpResponseMessage.StatusCode.ToString();
                                    if (tmpHttpResponseMessage.StatusCode == System.Net.HttpStatusCode.OK)
                                    {
                                        tmpCheckUrl.Result = "正常";
                                    }
                                    m_CheckUrls.Add(tmpCheckUrl);
                                    m_AllCheckUrls.Add(tmpCheckUrl);
                                    StateHasChanged();
                                }
                                else
                                {
                                    CheckUrlModel tmpCheckUrl = new CheckUrlModel();
                                    tmpCheckUrl.Url = tmpUrl;
                                    tmpCheckUrl.Status = "-1";
                                    tmpCheckUrl.Result = "异常";
                                    m_CheckUrls.Add(tmpCheckUrl);
                                    m_AllCheckUrls.Add(tmpCheckUrl);
                                    StateHasChanged();
                                }
                            }
                            catch (Exception ex)
                            {
                                CheckUrlModel tmpCheckUrl = new CheckUrlModel();
                                tmpCheckUrl.Url = tmpUrl;
                                tmpCheckUrl.Status = "-1";
                                tmpCheckUrl.Result = "异常";
                                m_CheckUrls.Add(tmpCheckUrl);
                                m_AllCheckUrls.Add(tmpCheckUrl);
                                StateHasChanged();
                                continue;
                            }
                        }
                        else
                        {
                            try
                            {
                                HttpResponseMessage tmpHttpResponseMessage = await m_HttpClient.GetAsync(tmpUrl);
                                if (tmpHttpResponseMessage != null)
                                {
                                    CheckUrlModel tmpCheckUrl = new CheckUrlModel();
                                    tmpCheckUrl.Url = tmpUrl;
                                    tmpCheckUrl.Status = tmpHttpResponseMessage.StatusCode.ToString();
                                    if (tmpHttpResponseMessage.StatusCode == System.Net.HttpStatusCode.OK)
                                    {
                                        tmpCheckUrl.Result = "正常";
                                    }
                                    if (!m_IsChecked)
                                    {
                                        m_CheckUrls.Add(tmpCheckUrl);
                                    }
                                    m_AllCheckUrls.Add(tmpCheckUrl);
                                    StateHasChanged();
                                    if (tmpHttpResponseMessage.StatusCode == System.Net.HttpStatusCode.OK)
                                    {
                                        await Check(tmpUrl);
                                    }
                                }
                                else
                                {
                                    CheckUrlModel tmpCheckUrl = new CheckUrlModel();
                                    tmpCheckUrl.Url = tmpUrl;
                                    tmpCheckUrl.Status = "-1";
                                    tmpCheckUrl.Result = "异常";
                                    if (!m_IsChecked)
                                    {
                                        m_CheckUrls.Add(tmpCheckUrl);
                                    }
                                    m_AllCheckUrls.Add(tmpCheckUrl);
                                    StateHasChanged();
                                }
                            }
                            catch (Exception ex)
                            {
                                CheckUrlModel tmpCheckUrl = new CheckUrlModel();
                                tmpCheckUrl.Url = tmpUrl;
                                tmpCheckUrl.Status = "-1";
                                tmpCheckUrl.Result = "异常";
                                if (!m_IsChecked)
                                {
                                    m_CheckUrls.Add(tmpCheckUrl);
                                }
                                m_AllCheckUrls.Add(tmpCheckUrl);
                                StateHasChanged();
                                continue;
                            }
                        }
                        if (m_IsChecked)
                        {
                            message = $"正在检测，已检测{m_CheckUrls.Count}条。";
                        }
                        else
                        {
                            message = $"正在检测，已检测{m_AllCheckUrls.Count}条。";
                        }
                    }
                }
            }
        }
    }
}
