@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Components.Web;
@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using ToolApp.Seo

@inject IViewLocalizer ViewLocalizer;
@inject IOptions<SeoOptions> SeoOptionsAccessor

@{
    var seo = SeoOptionsAccessor.Value;
    var requestCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var uiName = requestCultureFeature?.RequestCulture?.UICulture?.Name ?? "en";
    var isZh = uiName.StartsWith("zh", StringComparison.OrdinalIgnoreCase);
    var htmlLang = isZh ? "zh-CN" : "en";
    var ogLocale = isZh ? "zh_CN" : "en_US";

    var baseUrl = !string.IsNullOrWhiteSpace(seo.PublicBaseUrl)
        ? seo.PublicBaseUrl.TrimEnd('/')
        : $"{Context.Request.Scheme}://{Context.Request.Host.Value}{Context.Request.PathBase}".TrimEnd('/');

    var path = Context.Request.Path.Value;
    if (string.IsNullOrEmpty(path)) path = "/";
    // Razor Pages home is served as "/" and "/Index"
    if (string.Equals(path, "/Index", StringComparison.OrdinalIgnoreCase))
        path = "/";
    var canonicalUrl = path == "/" ? baseUrl + "/" : $"{baseUrl}{path}";

    ToolSeoCatalog.TryGet(path, out var seoEntry);

    var pageTitlePart = ViewData["Title"]?.ToString()?.Trim();
    if (string.IsNullOrWhiteSpace(pageTitlePart) && seoEntry != null)
        pageTitlePart = seoEntry.Title(isZh);
    // Prefer catalog for English UI (many .cshtml pages hardcode Chinese titles)
    else if (seoEntry != null && !isZh && path != "/")
        pageTitlePart = seoEntry.Title(false);
    // Home: always use catalog title when available (ViewData ToolOnline may be empty in default resx)
    if (path == "/" && seoEntry != null)
        pageTitlePart = seoEntry.Title(isZh);

    var documentTitle = string.IsNullOrWhiteSpace(pageTitlePart)
        ? "ToolApp"
        : (path == "/" ? $"ToolApp - {pageTitlePart}" : $"{pageTitlePart} - ToolApp");

    var metaDesc = ViewData["MetaDescription"] as string;
    if (string.IsNullOrWhiteSpace(metaDesc) && seoEntry != null)
        metaDesc = seoEntry.Description(isZh);
    // Index sets localized MetaDescription — keep it. For EN UI on other pages, prefer catalog
    // when ViewData description is missing (already handled) or is clearly Chinese-only leftover.
    if (seoEntry != null && !isZh && path != "/" && string.IsNullOrWhiteSpace(ViewData["MetaDescription"] as string))
        metaDesc = seoEntry.Description(false);
    if (string.IsNullOrWhiteSpace(metaDesc))
        metaDesc = isZh
            ? "ToolApp 免费在线工具：图片、文本、编码、转换与开发对照表，支持中英文。"
            : seo.DefaultMetaDescription;

    var metaKeywords = ViewData["MetaKeywords"] as string;
    if (string.IsNullOrWhiteSpace(metaKeywords) && seoEntry != null)
        metaKeywords = seoEntry.Keywords(isZh);

    var robots = ViewData["Robots"] as string;
    if (string.IsNullOrWhiteSpace(robots))
        robots = seoEntry?.NoIndex == true
            ? "noindex, nofollow"
            : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

    var ogImagePath = ViewData["OgImage"] as string ?? seo.DefaultOgImagePath;
    var ogImageUrl = "";
    if (!string.IsNullOrWhiteSpace(ogImagePath))
    {
        ogImageUrl = ogImagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? ogImagePath
            : baseUrl + (ogImagePath.StartsWith("/") ? ogImagePath : "/" + ogImagePath);
    }

    var jsonLd = SeoJsonLdBuilder.Build(baseUrl, canonicalUrl, documentTitle, metaDesc, isZh, seoEntry);
}

<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@documentTitle</title>
    <meta name="description" content="@metaDesc" />
    @if (!string.IsNullOrWhiteSpace(metaKeywords))
    {
        <meta name="keywords" content="@metaKeywords" />
    }
    <meta name="robots" content="@robots" />
    <meta name="author" content="ToolApp" />
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="zh-CN" href="@canonicalUrl" />
    <link rel="alternate" hreflang="en" href="@canonicalUrl" />
    <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@documentTitle" />
    <meta property="og:description" content="@metaDesc" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:site_name" content="ToolApp" />
    <meta property="og:locale" content="@ogLocale" />
    <meta property="og:locale:alternate" content="@(isZh ? "en_US" : "zh_CN")" />
    @if (!string.IsNullOrEmpty(ogImageUrl))
    {
        <meta property="og:image" content="@ogImageUrl" />
    }
    <meta name="twitter:card" content="@(!string.IsNullOrEmpty(ogImageUrl) ? "summary_large_image" : "summary")" />
    <meta name="twitter:title" content="@documentTitle" />
    <meta name="twitter:description" content="@metaDesc" />
    @if (!string.IsNullOrEmpty(ogImageUrl))
    {
        <meta name="twitter:image" content="@ogImageUrl" />
    }
    <script type="application/ld+json">@Html.Raw(jsonLd)</script>

