@page "/TxtTools/WordCount"

<div class="tool-page it-page tt-page">
    <header class="it-hero">
        <h1>字数统计</h1>
        <p>实时统计总字符数、中文、英文、数字与标点，适合写作与编辑场景。</p>
    </header>

    <div class="it-studio">
        <div class="it-toolbar">
            <div class="it-toolbar-fields">
                <span class="it-meta mb-0">输入或粘贴文本后，右侧自动更新统计结果。</span>
            </div>
            <div class="it-toolbar-actions">
                <button type="button" class="it-btn it-btn-outline" @onclick="Clear">清空</button>
            </div>
        </div>

        <div class="tt-split tt-split--editor">
            <div class="tt-field">
                <span class="tt-field-label">文章内容</span>
                <textarea class="form-control" placeholder="请在这里输入文章内容" @bind="Result" @bind:event="oninput"></textarea>
            </div>
            <div class="tt-field">
                <span class="tt-field-label">统计结果</span>
                <ul class="tt-stats">
                    <li>
                        <span>总字数</span>
                        <span class="tt-stats-value">@AllCount</span>
                    </li>
                    <li>
                        <span>中文</span>
                        <span class="tt-stats-value">@CCount</span>
                    </li>
                    <li>
                        <span>英文</span>
                        <span class="tt-stats-value">@ECount</span>
                    </li>
                    <li>
                        <span>数字</span>
                        <span class="tt-stats-value">@NCount</span>
                    </li>
                    <li>
                        <span>标点符号</span>
                        <span class="tt-stats-value">@SCount</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private string m_Result = "";
    public string Result
    {
        get => m_Result;
        set
        {
            m_Result = value;
            Count(value);
        }
    }
    public int AllCount;
    public int ECount;
    public int CCount;
    public int NCount;
    public int SCount;

    private void Count(string value)
    {
        AllCount = 0;
        ECount = 0;
        NCount = 0;
        SCount = 0;
        CCount = 0;
        foreach (char item in value)
        {
            AllCount++;
            if (char.IsDigit(item))
            {
                NCount++;
            }
            if (char.IsLetter(item) && !IsCjk(item))
            {
                ECount++;
            }
            if (char.IsPunctuation(item))
            {
                SCount++;
            }
            if (IsCjk(item))
            {
                CCount++;
            }
        }
    }

    private static bool IsCjk(char ch) => ch >= '\u4e00' && ch <= '\u9fff';

    private void Clear()
    {
        Result = "";
    }
}
