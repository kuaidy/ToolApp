@page
@using ToolApp.Pages.Common;
@model RegularModel
@{
    ViewData["Title"] = "正则表达式测试";
}
<div class="tool-page it-page tt-page">
    <header class="it-hero">
        <h1>@ViewData["Title"]</h1>
        <p>输入正则模式与待匹配文本，快速验证并查看匹配结果。</p>
    </header>

    <div class="it-studio">
        <div class="it-toolbar">
            <div class="it-toolbar-fields">
                <span class="it-meta mb-0">使用 JavaScript 正则引擎，支持全局匹配。</span>
            </div>
            <div class="it-toolbar-actions">
                <button type="button" class="it-btn it-btn-primary" onclick="OnMatch()">点击测试</button>
            </div>
        </div>

        <div class="tt-field">
            <span class="tt-field-label">待匹配文本</span>
            <textarea id="RegularInputValue" placeholder="请输入需要匹配的内容"></textarea>
        </div>

        <div class="tt-regex-pattern">
            <span class="tt-field-label mb-0">正则表达式</span>
            <input id="RegularPattern" placeholder="请输入表达式" />
        </div>

        <div class="tt-field">
            <span class="tt-field-label">匹配结果</span>
            <textarea id="RegularOutputValue" readonly placeholder="匹配结果将显示在这里"></textarea>
        </div>
    </div>

    <section class="it-features">
        <p class="it-features-desc">
            正则表达式测试工具，是检验正则模式和给定文本之间是否匹配的工具，它能够把匹配到的结果高亮显示，是在线验证正则表达式的必备工具。本工具使用原生 JS 实现，具有极高的正则解析和匹配效率。另外，本工具还提供了各种常用正则表达式的写法，可以作为日常书写正则表达式时的参考。
        </p>
        <component type="typeof(Description)" param-DescFileName='"RegexTest.md"' param-EmbedOnly="true" render-mode="ServerPrerendered" />
    </section>
</div>

<div id="content_view" class="d-none">
    <textarea id="content_editor" style="display:none;">@ViewData["Content"]</textarea>
</div>

<script>
function OnMatch() {
    var pattern = document.getElementById("RegularPattern").value;
    var str = document.getElementById("RegularInputValue").value;
    var output = document.getElementById("RegularOutputValue");

    if (!pattern) {
        output.value = "请先输入正则表达式。";
        return;
    }

    try {
        var regex = new RegExp(pattern, "g");
        var result = str.match(regex);
        if (null == result || 0 == result.length) {
            output.value = "（没有匹配）";
            return;
        }
        var strResult = "共找到 " + result.length + " 处匹配：\r\n";
        for (var i = 0; i < result.length; ++i) {
            strResult = strResult + result[i] + "\r\n";
        }
        output.value = strResult;
    } catch (e) {
        output.value = "正则表达式无效：" + e.message;
    }
}
</script>
