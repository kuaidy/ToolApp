@page
@model MarkdownEditModel
@{
    ViewData["Title"] = "Markdown编辑";
}
<div class="tool-page it-page tt-page">
    <header class="it-hero">
        <h1>@ViewData["Title"]</h1>
        <p>在线 Markdown 编辑与实时预览，支持公式、流程图与常用扩展语法。</p>
    </header>

    <div class="it-studio">
        <div class="it-toolbar">
            <div class="it-toolbar-fields">
                <span class="it-meta mb-0">支持标准 Markdown、KaTeX 公式、流程图与时序图。</span>
            </div>
        </div>

        <div class="tt-editor-host">
            <div id="MarkdownEdit">
                <textarea id="TextMarkdownEdit"></textarea>
            </div>
        </div>
    </div>

    <section class="it-features">
        <p class="it-features-desc">
            本工具提供在线 Markdown 编辑功能，主要功能包括：支持标准 Markdown 语法，支持自动识别 HTML 标签以及自动识别链接、Email 地址；支持基于 KaTeX 的 TeX 科学公式，支持自动保存功能以及实时预览功能。
        </p>
    </section>
</div>

<div id="content_view" class="d-none">
    <textarea id="content_editor" style="display:none;">@ViewData["Content"]</textarea>
</div>

<script src="~/lib/MarkDown/js/editormd.js"></script>
<script src="~/lib/MarkDown/lib/marked.min.js"></script>
<script src="~/lib/MarkDown/lib/prettify.min.js"></script>
<script src="~/lib/MarkDown/lib/raphael.min.js"></script>
<script src="~/lib/MarkDown/lib/underscore.min.js"></script>
<script src="~/lib/MarkDown/lib/sequence-diagram.min.js"></script>
<script src="~/lib/MarkDown/lib/flowchart.min.js"></script>
<script src="~/lib/MarkDown/lib/jquery.flowchart.min.js"></script>

<script>
    $(function () {
        editormd("MarkdownEdit", {
            width: "100%",
            height: 600,
            path: "/lib/MarkDown/lib/",
            saveHTMLToTextarea: true,
            searchReplace: true,
            htmlDecode: "style,script,iframe|on*",
            emoji: true,
            taskList: true,
            tex: true,
            flowChart: true,
            sequenceDiagram: true
        });
    });
</script>
